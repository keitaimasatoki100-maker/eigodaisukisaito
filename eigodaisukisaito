                { id: 'sports', count: sportsCorrectSet.size, total: SPORTS_DATA.length },
                { id: 'building', count: buildingCorrectSet.size, total: BUILDING_DATA.length },
                { id: 'verb', count: verbCorrectSet.size, total: VERB_DATA.length },
                { id: 'adjective', count: adjectiveCorrectSet.size, total: ADJECTIVE_DATA.length },
                { id: 'country', count: countryCorrectSet.size, total: COUNTRY_DATA.length },
                { id: 'vehicle', count: vehicleCorrectSet.size, total: VEHICLE_DATA.length },
                { id: 'stationery', count: stationeryCorrectSet.size, total: STATIONERY_DATA.length },
                { id: 'subject', count: subjectCorrectSet.size, total: SUBJECT_DATA.length }
            ];

            const allCurrentlyUnlockedCleared = unlockedModes.every(modeId => {
                const item = caseModes.find(m => m.id === modeId);
                if (!item) return true;
                return item.count >= item.total;
            });

            if (allCurrentlyUnlockedCleared) {
                const lockedModes = caseModes.filter(m => !unlockedModes.includes(m.id));
                if (lockedModes.length > 0) {
                    const randomIndex = Math.floor(Math.random() * lockedModes.length);
                    const newlyUnlocked = lockedModes[randomIndex];
                    unlockedModes.push(newlyUnlocked.id);
                    localStorage.setItem('alphabet_unlocked_modes', JSON.stringify(unlockedModes));

                    setTimeout(() => {
